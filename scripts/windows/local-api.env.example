# Copy this file to local-api.env in the same directory. Never commit that file.
# Optional matching single or double quotes around a value are removed on load.

# Required. Must match the bearer token configured in Apps Script.
NRM_INTERNAL_API_TOKEN=replace-with-the-existing-long-random-secret

# Required. Ollama runs on the same Windows machine, so loopback is preferred.
NRM_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Required. A relative path is resolved from the repository root.
PYTHONPATH=local-api

# Required by the service launcher. A relative path is resolved from the repo root.
NRM_PYTHON_EXE=local-api\.venv\Scripts\python.exe

# Optional Stage 6 overrides.
NRM_OLLAMA_TEXT_MODEL=llama3.1:8b
NRM_OLLAMA_TIMEOUT_SECONDS=120

# Required for Stage 7 MMS. Keep these separate from Apps Script properties.
NRM_TWILIO_ACCOUNT_SID=replace-with-your-twilio-account-sid
NRM_TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token

# Stage 7 vision model. Install it manually with: ollama pull qwen2.5vl:3b
NRM_OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Stage 7 vision context. 8192 leaves headroom after image preprocessing.
NRM_OLLAMA_VISION_NUM_CTX=8192
